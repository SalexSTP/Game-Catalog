@model Web.ViewModels.Reports.ReportsIndexViewModel
@{
    ViewData["Title"] = UiText.T(Context, "Reports");
}

<section class="page-heading">
    <div>
        <span class="eyebrow">@UiText.T(Context, "RequiredTaskOutput")</span>
        <h1>@UiText.T(Context, "GameReports")</h1>
        <p class="text-secondary mb-0">@UiText.T(Context, "ReportsDescription")</p>
    </div>
    <a asp-controller="Games" asp-action="Index" class="btn btn-outline-light">@UiText.T(Context, "BackToCatalog")</a>
</section>

<div class="accordion reports-accordion" id="reportsAccordion">
    <div class="accordion-item report-item">
        <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                <span>
                    <strong>@UiText.T(Context, "ReportHighlyRated")</strong>
                    <small>@UiText.T(Context, "ReportHighlyRatedSub")</small>
                </span>
            </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#reportsAccordion">
            <div class="accordion-body">
                @await Html.PartialAsync("_GameTable", Model.HighlyRatedGames)
            </div>
        </div>
    </div>

    <div class="accordion-item report-item">
        <h2 class="accordion-header" id="headingTwo">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                <span>
                    <strong>@UiText.T(Context, "ReportRecentPc")</strong>
                    <small>@UiText.T(Context, "ReportRecentPcSub")</small>
                </span>
            </button>
        </h2>
        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#reportsAccordion">
            <div class="accordion-body">
                @await Html.PartialAsync("_GameTable", Model.RecentPcGames)
            </div>
        </div>
    </div>

    <div class="accordion-item report-item">
        <h2 class="accordion-header" id="headingThree">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                <span>
                    <strong>@UiText.T(Context, "ReportKids")</strong>
                    <small>@UiText.T(Context, "ReportKidsSub")</small>
                </span>
            </button>
        </h2>
        <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#reportsAccordion">
            <div class="accordion-body">
                @foreach (var group in Model.KidFriendlyGroups)
                {
                    <div class="genre-section">
                        <h3>@UiText.Genre(Context, group.Genre)</h3>
                        @await Html.PartialAsync("_GameTable", group.Games)
                    </div>
                }
                @if (!Model.KidFriendlyGroups.Any())
                {
                    <p class="text-secondary mb-0">@UiText.T(Context, "NoKidFriendly")</p>
                }
            </div>
        </div>
    </div>

    <div class="accordion-item report-item">
        <h2 class="accordion-header" id="headingFour">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                <span>
                    <strong>@UiText.T(Context, "ReportTop3")</strong>
                    <small>@UiText.T(Context, "ReportTop3Sub")</small>
                </span>
            </button>
        </h2>
        <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#reportsAccordion">
            <div class="accordion-body">
                @foreach (var group in Model.TopGamesByGenre)
                {
                    <div class="genre-section">
                        <h3>@UiText.Genre(Context, group.Genre)</h3>
                        @await Html.PartialAsync("_GameTable", group.Games)
                    </div>
                }
                @if (!Model.TopGamesByGenre.Any())
                {
                    <p class="text-secondary mb-0">@UiText.T(Context, "NoGamesFound")</p>
                }
            </div>
        </div>
    </div>
</div>
